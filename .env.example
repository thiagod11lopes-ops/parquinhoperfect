# Firebase (web client — also available in src/firebase/config.js)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=parquinhoperfect.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=parquinhoperfect
VITE_FIREBASE_STORAGE_BUCKET=parquinhoperfect.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=284387072409
VITE_FIREBASE_APP_ID=

# Mercado Pago (cobrança só do Administrador)
# URL base das Cloud Functions (sem barra final)
VITE_MP_FUNCTIONS_URL=https://us-central1-parquinhoperfect.cloudfunctions.net
# true = usa sandbox_init_point
VITE_MP_SANDBOX=true
# Opcional: links prontos do painel MP por plano (JSON)
# VITE_MP_PLAN_LINKS={"starter":"https://...","pro":"https://...","enterprise":"https://..."}

# Secrets das Cloud Functions (NÃO colocar no Vite):
# firebase functions:secrets:set MP_ACCESS_TOKEN
